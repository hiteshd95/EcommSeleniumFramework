<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Ecomm" thread-count="5" parallel="tests">

    <listeners>
        <listener class-name="utilities.AllureListener"/>
    </listeners>

    <test thread-count="5" name="Ecomm Tests in Edge">
        <parameter name="os" value="windows"></parameter>
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="testcases.TC001_AccountRegistrationTest"/>
        </classes>
    </test>

    <test thread-count="5" name="Ecomm Tests in Chrome">
        <parameter name="os" value="windows"></parameter>
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="testcases.TC002_LoginTest"/>
        </classes>
    </test>

    <test thread-count="5" name="Ecomm Tests in Firefox">
        <parameter name="os" value="windows"></parameter>
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="testcases.TC003_LoginDDT"/>
        </classes>
    </test>

</suite>